"""NIH RePORTER Retriever - Snakemake workflow.

Optional step 0 - Matchmaker (if matchmaker.enabled):
    your Specific Aims text -> RePORTER Matchmaker -> program officers ranked by
    how many similar projects they manage -> keep those above a cutoff
    -> matchmaker/program_officers.tsv (added to any program_officers table)

Phase 1 - retrieval only (no AI):
    input tables -> RePORTER searches (+ full record lookup per grant) -> raw JSON
      -> grants/{portfolio}.json   one readable grant file per search term, plus one
                                   per group (e.g. a consortium) of 2+ searches
      -> grants/manifest.json      written only if every grant file passes checks
    plus a portfolio database (TSV / SQLite) and Markdown reports.

Phase 2 - summarisation with a local LLM (Ollama), if summarize.enabled:
    grants/manifest.json + grants/{portfolio}.json -> summaries/{portfolio}.md / .json

Run from the repository root:
    snakemake -s workflow/Snakefile --configfile config/config.yaml --cores 1 --resources ollama=1
    ... retrieve      # Phase 1 only (plus Matchmaker if enabled)
    ... matchmaker    # just the Matchmaker step, to check the officer cutoff
"""

import json
import logging
import sys
from pathlib import Path

REPO_ROOT = Path(workflow.basedir).parent
sys.path.insert(0, str(REPO_ROOT))

from nih_reporter.queries import QuerySpec, build_queries, groups_of
from nih_reporter import pipeline, database, reports, landscape, summarize, matchmaker

_pkg_log = logging.getLogger("nih_reporter")
_pkg_log.setLevel(logging.INFO)
if not _pkg_log.handlers:
    _console = logging.StreamHandler()
    _console.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(name)s: %(message)s"))
    _pkg_log.addHandler(_console)
    _pkg_log.propagate = False

if not config:
    raise ValueError("No config given. Run with --configfile config/config.yaml")

OUT = Path(config.get("output_dir", "results"))
API_CFG = config.get("api", {})
INPUTS = config.get("inputs") or {}
FILTERS = config.get("filters") or {}

MM_CFG = config.get("matchmaker") or {}
MATCHMAKER = bool(MM_CFG.get("enabled", False))
MM_DIR = OUT / "matchmaker"

SUMMARIZE_CFG = config.get("summarize") or {}
SUMMARIZE = bool(SUMMARIZE_CFG.get("enabled", False))

# Searches from the input tables are known now; with Matchmaker on, the selected
# officers are added once the matchmaker checkpoint has run.
TABLE_SPECS = build_queries(INPUTS, FILTERS, base_dir=".", allow_empty=MATCHMAKER)


def all_specs(via_checkpoint=True):
    """All searches: input tables + (with Matchmaker on) the selected officers.

    Input functions go through the checkpoint (via_checkpoint=True), which makes
    Snakemake run Matchmaker first and re-plan afterwards. Params functions may
    not touch a checkpoint they don't list as input, so they read the selected
    table directly - it always exists by the time those jobs are scheduled.
    """
    if not MATCHMAKER:
        return TABLE_SPECS
    if via_checkpoint:
        selected = checkpoints.matchmaker.get().output.officers
    else:
        selected = MM_DIR / "program_officers.tsv"
    inputs = dict(INPUTS)
    po = inputs.get("program_officers") or []
    inputs["program_officers"] = ([po] if isinstance(po, str) else list(po)) + [selected]
    specs = build_queries(inputs, FILTERS, base_dir=".", allow_empty=True)
    if not specs:
        raise ValueError(f"No searches: Matchmaker selected no officers ({selected}) "
                         "and the input tables are empty.")
    return specs


def queries(via_checkpoint=True):
    return {q.query_id: q for q in all_specs(via_checkpoint)}


def qids(via_checkpoint=True):
    return sorted(queries(via_checkpoint))


def groups(via_checkpoint=True):
    return groups_of(all_specs(via_checkpoint))


def portfolios(via_checkpoint=True):
    return qids(via_checkpoint) + sorted(groups(via_checkpoint))


def log_to(path):
    """Send this job's log records to its Snakemake log file as well as stderr."""
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    handler = logging.FileHandler(path, mode="w")
    handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(name)s: %(message)s"))
    logging.getLogger("nih_reporter").addHandler(handler)
    return handler


def release(handler):
    logging.getLogger("nih_reporter").removeHandler(handler)
    handler.close()


wildcard_constraints:
    qid="(?:po|opp|txt)_[A-Za-z0-9_\\-]+",
    gid="group_[A-Za-z0-9_\\-]+",
    pid="[A-Za-z0-9_\\-]+",


GRANT_MANIFEST = OUT / "grants" / "manifest.json"


def phase1(wildcards=None):
    return [
        GRANT_MANIFEST,
        OUT / "database" / "portfolio.tsv",
        OUT / "database" / "portfolio.jsonl",
        OUT / "database" / "nih_reporter.sqlite",
        OUT / "reports" / "program_officer_summary.tsv",
        *expand(OUT / "tables" / "{qid}.tsv", qid=qids()),
    ]


def summaries(wildcards=None):
    return expand(OUT / "summaries" / "{pid}.md", pid=portfolios()) if SUMMARIZE else []


rule all:
    input:
        phase1,
        summaries,


# Phase 1 only (no LLM):  snakemake ... retrieve
rule retrieve:
    input:
        phase1,


# Step 0: Specific Aims text -> Matchmaker -> selected program officers.
# Reruns when the aims file or the matchmaker settings change.
# To re-query Matchmaker with unchanged text: --forcerun matchmaker
checkpoint matchmaker:
    input:
        aims=MM_CFG.get("aims_file") or "MATCHMAKER_AIMS_FILE_NOT_SET",
    output:
        officers=MM_DIR / "program_officers.tsv",
        ranked=MM_DIR / "program_officers_all.tsv",
        report=MM_DIR / "selection.md",
        raw=MM_DIR / "matchmaker.json",
    params:
        cfg=json.dumps(MM_CFG, sort_keys=True),
    log:
        OUT / "logs" / "matchmaker.log",
    run:
        h = log_to(log[0])
        try:
            sel = MM_CFG.get("selection") or {}
            matchmaker.run_matchmaker(
                Path(input.aims).read_text(encoding="utf-8"), MM_DIR,
                active_only=MM_CFG.get("active_only", FILTERS.get("active_only", True)),
                method=sel.get("method", "knee"), value=sel.get("value"),
                min_projects=int(sel.get("min_projects", 2)), max_officers=sel.get("max_officers"),
                group=MM_CFG.get("group") or "", count_source=sel.get("count_source", "current"))
        finally:
            release(h)


# One small JSON spec per query. Because the spec is passed as a param, the rule
# (and everything downstream of that one query) reruns only when that query's
# criteria change - editing one row of an input table does not refetch the rest.
rule query_spec:
    output:
        OUT / "queries" / "{qid}.json",
    params:
        spec=lambda wc: json.dumps(queries(False)[wc.qid].to_dict(), sort_keys=True),
    run:
        pipeline.write_spec(QuerySpec.from_dict(json.loads(params.spec)), output[0])


# Hits the API. Requests are throttled process-wide (~1/s, per NIH guidance),
# so running with several cores is safe but not much faster.
# To refresh data later:  snakemake ... --forcerun fetch_query
rule fetch_query:
    input:
        OUT / "queries" / "{qid}.json",
    output:
        OUT / "raw" / "{qid}.json",
    log:
        OUT / "logs" / "fetch" / "{qid}.log",
    retries: 2
    run:
        h = log_to(log[0])
        try:
            pipeline.fetch_query(input[0], output[0], API_CFG)
        finally:
            release(h)


rule flatten_query:
    input:
        OUT / "raw" / "{qid}.json",
    output:
        OUT / "tables" / "{qid}.tsv",
    run:
        pipeline.flatten_query(input[0], output[0])


rule build_database:
    input:
        lambda wc: expand(OUT / "raw" / "{qid}.json", qid=qids()),
    output:
        OUT / "database" / "queries.tsv",
        OUT / "database" / "records.tsv",
        OUT / "database" / "portfolio.tsv",
        OUT / "database" / "query_hits.tsv",
        OUT / "database" / "portfolio.jsonl",
        OUT / "database" / "nih_reporter.sqlite",
    log:
        OUT / "logs" / "build_database.log",
    run:
        h = log_to(log[0])
        try:
            database.build_database(input, OUT / "database")
        finally:
            release(h)


rule reports:
    input:
        OUT / "database" / "portfolio.tsv",
        OUT / "database" / "queries.tsv",
    output:
        OUT / "reports" / "program_officer_summary.tsv",
        directory(OUT / "reports" / "portfolios"),
    run:
        reports.write_reports(OUT / "database", OUT / "reports")


# Phase 1 hand-off: one readable JSON file per search term holding every grant
# that search found, with all retrieved fields (no summarisation).
rule grant_file:
    input:
        OUT / "raw" / "{qid}.json",
    output:
        OUT / "grants" / "{qid}.json",
    run:
        landscape.build_grant_file(input[0], output[0])


# Combined grant file for each group of 2+ searches (e.g. a consortium).
rule group_grant_file:
    input:
        lambda wc: expand(OUT / "raw" / "{qid}.json", qid=groups()[wc.gid]),
    output:
        OUT / "grants" / "{gid}.json",
    params:
        group=lambda wc: queries(False)[groups(False)[wc.gid][0]].group,
    run:
        landscape.build_grant_file(list(input), output[0], group=params.group)


# Checks every grant file exists, parses, is internally consistent and matches
# the raw API pull. Writes the manifest only if all pass; otherwise the job
# fails with the list of problems. Phase 2 rules take the manifest as input.
rule check_grant_files:
    input:
        grants=lambda wc: expand(OUT / "grants" / "{pid}.json", pid=portfolios()),
        raw=lambda wc: expand(OUT / "raw" / "{qid}.json", qid=qids()),
    output:
        GRANT_MANIFEST,
    params:
        raw_lists=lambda wc: json.dumps([
            [str(OUT / "raw" / f"{q}.json") for q in groups(False)[p]] if p in groups(False)
            else str(OUT / "raw" / f"{p}.json")
            for p in portfolios(False)
        ]),
    log:
        OUT / "logs" / "check_grant_files.log",
    run:
        h = log_to(log[0])
        try:
            m = landscape.check_grant_files(input.grants, json.loads(params.raw_lists), output[0])
            for f in m["files"]:
                for w in f["warnings"]:
                    logging.getLogger("nih_reporter.check").warning(w)
            logging.getLogger("nih_reporter.check").info(
                "%d grant files OK (%d grants)", m["n_files"], m["n_grants_total"])
        finally:
            release(h)


# Phase 2: summarise each checked grant file with a local LLM via Ollama.
# Takes the manifest as input, so it only runs once every grant file exists and
# passed its checks. Per-grant digests are cached in summaries/cache/, so after
# a data refresh only new or changed grants go back through the model.
# Reruns when the summarize config (model, port, prompts, ...) changes.
rule summarize_portfolio:
    input:
        manifest=GRANT_MANIFEST,
        grants=OUT / "grants" / "{pid}.json",
    output:
        md=OUT / "summaries" / "{pid}.md",
        js=OUT / "summaries" / "{pid}.json",
    params:
        cfg=json.dumps(SUMMARIZE_CFG, sort_keys=True),
    log:
        OUT / "logs" / "summarize" / "{pid}.log",
    resources:
        ollama=1,
    run:
        h = log_to(log[0])
        try:
            summarize.summarize_portfolio(
                input.grants, output.js, output.md, SUMMARIZE_CFG,
                cache_dir=OUT / "summaries" / "cache", manifest=input.manifest)
        finally:
            release(h)
